# Keep your actual keys in .env in this folder. Never use NEXT_PUBLIC_ for secrets.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional native English teaching voice; defaults to ELEVENLABS_VOICE_ID.
# Lessons use Multilingual v2 at 0.85 speed; bilingual guidance uses Eleven v3.
ELEVENLABS_ENGLISH_LESSON_VOICE_ID=
# Select a Hebrew narration voice separately from English; review its v3 delivery.
ELEVENLABS_HEBREW_VOICE_ID=
# Hebrew prerecorded audio uses Eleven v3.
ELEVENLABS_HEBREW_MODEL=eleven_v3
# fal.ai welcome video generation. The existing fal_api_key name is also accepted.
FAL_KEY=
